{
    "version": "2.0.0",    
     "windows": {
         "command": "build.bat",
         "isShellCommand": true,
         "showOutput": "always"        
     },
     "linux": {
         "command": "make",
         "args": [],
         "isShellCommand": true,
         "showOutput": "always",
         "problemMatcher": {
             "owner": "cpp",
             "fileLocation": [
                 "relative",
                 "${workspaceRoot}"
             ],
             "pattern": {
                 "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                 "file": 1,
                 "line": 2,
                 "column": 3,
                 "severity": 4,
                 "message": 5
             }
         }
     },    
     "osx": {
         "command": "clang++",
         "args": [
             "-Wall",
             "helloWorld.cpp",
             "-v"
         ],
         "isShellCommand": true,
         "showOutput": "always",
         "problemMatcher": {
             "owner": "cpp",
             "fileLocation": [
                 "relative",
                 "${workspaceRoot}"
             ],
             "pattern": {
                 "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                 "file": 1,
                 "line": 2,
                 "column": 3,
                 "severity": 4,
                 "message": 5
             }
         }
    },
    "tasks": [
        {
            "label": "make",
            "type": "shell",
            "problemMatcher": [],
            "group": {
                "_id": "build",
                "isDefault": false
            }
        }
    ]
 }
 